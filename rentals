  if (wasOpen) overlay.firstElementChild.style.animation = 'none';
  kcSaveReturnFocus('dynamicModal');
  overlay.classList.remove('hidden');
  kcWindowise(overlay);
  suppressCardScrim(true);
  autofocusFirstField(overlay);
}

