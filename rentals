function kcConfirmDone(ok) {
  const el = document.getElementById('kcConfirm');
  if (el) el.classList.add('hidden');
  const r = kcConfirmResolve; kcConfirmResolve = null;
  kcRestoreReturnFocus('kcConfirm');
  if (r) r(ok);
