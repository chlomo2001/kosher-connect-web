    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;min-width:0;">
      ${filterSelects}
      <select class="form-input kc-fs-sel" title="Sort by"
        onchange="kcViewSet('${key}','sort',this.value)">${opts(sorts, st.sort)}</select>
      ${viewChips}
