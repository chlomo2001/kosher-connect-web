          <option value="call_in">📞 Call — incoming</option>
          <option value="call_out">📲 Call — outgoing</option>
          <option value="message">💬 Message${WHATSAPP_ENABLED ? ' (WhatsApp / SMS)' : ' (SMS)'}</option>
          <option value="note">📝 Note</option>
