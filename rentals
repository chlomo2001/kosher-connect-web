/* Category headings INSIDE the Accounts & subscriptions table. The register is
   the one screen that answers "what does the shop run on", and it was a flat
   run of rows sorted alphabetically by category — email, finance,
   infrastructure… — with the category repeated in small print under every
   single name. The heading says it once per group, in the order somebody would
   actually name them (owner, 25 Aug). Sticky so the group is still identifiable
   after scrolling past its head on a phone. */
.kc-biz-head td {
  position: sticky; top: 0; z-index: 1;
  background: var(--surface2);
  font-size: var(--fs-micro); font-weight: 700; letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--ink-secondary);
  padding: 7px 16px 6px;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border-subtle);
}
/* The first group sits directly under the table head, which already draws its
   own rule — two hairlines together read as a mistake. */
.kc-biz-head:first-child td { border-top: 0; }

/* ── The counter tablet: WCAG 2.5.5 (AAA), 44×44 ─────────────────────────
   globals.css already declares this floor — `.btn, .form-input, select {
   min-height: 44px }` under (pointer: coarse), written when the touch audit
   went in. It has never applied to a small button or a filter select, because
   `.btn-sm` (34px), `.btn-sm.btn-primary` (26px) and `.kc-fs-sel`
   (min-height: 0) sit in THIS sheet, which loads second — the same tie decided
   by file order that `.tm-pick-col input` carries a note about 3,000 lines up.
   Nothing went red over it: at 34px they cleared 2.5.8's 24px floor
   comfortably, and 24 was all the sweep asked for.

   So this block is not a new policy. It is the policy already written, stated
   where it can win, and now measured: `node ops/harness/render.mjs --targets
   --width 390 --min 44`.

   Scoped to `pointer: coarse` and nothing else. On a desk with a mouse the
   sizes above are deliberate and stay — a 44px floor on every row action would
   double the height of every table, and the owner asked for dense tables. The
   case this serves is the counter tablet: a thumb, one-handed, while somebody
   is standing at the till waiting. 44 is the figure Apple and Google both
   publish and it is the width of an adult fingertip; 24 only ever meant "you
   can hit it if you are careful", which is not the state anybody serving a
   customer is in. */
@media (pointer: coarse) {
  /* Buttons. The two-class primary/danger rules need two classes back, or
     they keep their 26px on specificity rather than on merit. */
  .btn-sm { min-height: 44px; }
  .btn-sm.btn-primary, .btn-primary.btn-sm,
  .btn-sm.btn-danger, .btn-danger.btn-sm { min-height: 44px; }
  /* Row actions and the chips beside them. These were 40 — close enough to
     pass at AA and not close enough to be comfortable. */
  .action-btn, .card-tool, .task-mini, .cm-chip, .kc-view-save,
  .kc-view-chip, .kc-view-chip button { min-height: 44px; }
  .action-btn, .card-tool { min-width: 44px; }
  /* Filter and sort selects. `min-height: 0` is there so the control can
     shrink to its label at 320px — a WIDTH argument, which is why it may keep
     the width half and give the height back. */
  .kc-fs-sel { min-height: 44px; }
  /* A name in a table cell is not a link in a sentence, so 2.5.5's inline
     exception does not reach it — and on this app it is the main way a person
     opens a customer. The row grows; on a tablet that is the right trade. */
  .kc-namelink, a.dash-link, span.dash-link { display: inline-flex; align-items: center; min-height: 44px; }
  /* Whole rows that are one big button: the dashboard's headline row and each
     line of the activity feed. */
  .dash-hero-row, .feed-item.dash-link { min-height: 44px; }
  /* Settings' section rail and the wallet history rows. Both only appear on a
     wide screen — the rail collapses below 1100px and the history list is a
     two-column layout — so neither had ever been in front of a sweep run at
     390. A 1280px touch screen is an iPad in landscape. */
  .rail-item, .history-item { min-height: 44px; }
  /* The panel resize grip keeps its 13px mark and gets a fingertip around it —
     the drawn corner is a ::after, so the box can grow without the screen
     changing. */
  .kc-grip { width: 44px; height: 44px; }
  /* An icon-only button is 44 tall and 35 wide, which is a target 20% short in
     the direction nobody looked. A floor on the other axis costs nothing:
     every button with a word in it is already wider than this. */
  .btn, .cm-chip { min-width: 44px; }

  /* ── inside the dialogs ──
     `node ops/harness/modals.mjs --targets --min 44` is new tonight, and it
     answers a question nothing here had ever asked: the page sweep renders a
     static page, so the thirty-odd dialogs — which is where most of this app's
     controls actually live — had never been measured for size at all.

     The first run found the close ✕ at 34×34 on EVERY dialog, and the till's
     payment-method and note buttons at 28px tall. The till is the counter
     surface: it is used standing up, on a tablet, with a customer waiting, and
     its buttons were the smallest things in the app. */
  .modal-x { min-width: 44px; min-height: 44px; }
  .pos-method, .pos-note, .pos-cat, .pos-tile { min-height: 44px; }
  .biz-tab, .kc-subtab, .card-menu-btn, .kc-cat-chip, .dup-name,
  .kc-undo-btn, .palette-item, .rd-act, .cs-btn, .eq-btn, .kc-rowmenu-item,
  .kc-add-more, .card-action {
    min-height: 44px;
  }
  .pos-note { min-width: 44px; }
  /* The customer's phone and email, on the card and again on the full page.
     They are facts on their own line, not links in a sentence — and they are
     what somebody presses to ring a customer back. 20px and 16px. */
  .detail-meta a, .kc-id-value a { display: inline-flex; align-items: center; min-height: 44px; }
  /* The returned/not-returned slider. Its two halves are absolutely positioned
     to fill the track, so the track is what has to grow — sizing the halves
     would leave them hanging out of it. */
  .eq-slide-track { min-height: 44px; }
  /* The customer search box was never in the floor's selector list at all. */
  .search-box { min-height: 44px; }
  /* …and the 71 inline `min-height:0` in the Kol Torah tables, the till and
     the carrier lists. An inline style cannot be outranked, only overridden —
     the same lever `.kc-stack-sm td` needs 4,000 lines up, and for the same
     reason. They were written to keep a table row compact on a desk, which is
     a fine thing to want and not a thing to want under a thumb. */
  .form-input { min-height: 44px !important; }

  /* Checkboxes and radios, the last thing standing between this app and 2.5.5.
     They were 24×24 — the AA floor, and the one control on the counter tablet
     that is genuinely fiddly: the row-select boxes down the side of Rentals,
     SIMs, Bookings, Virtual Numbers and the two mail lists, and the tick that
     marks a task done.

     Simply setting them to 44×44 was tried first and looks wrong — a native
     checkbox does not scale its tick with its box, so what you get beside a
     15px label is a large empty square that reads as an unfilled text field.
     The screenshot is what settled it.

     So the BOX grows to 44 and the CONTROL stays 24, drawn here. That is what
     the criterion actually asks for: 2.5.5 measures the target — the region
     that accepts the pointer — not the ink. `appearance: none` is the price,
     and it is confined to `pointer: coarse`, so every mouse keeps the browser's
     own checkbox and this paint has one device to be right on.

     :indeterminate is not decoration — two select-all boxes (rentals, SIMs)
     set it from JS when some rows in view are picked. Under `appearance: none`
     the browser stops drawing that state, so it is drawn here or it is gone. */
  input[type="checkbox"], input[type="radio"] {
    appearance: none; -webkit-appearance: none;
    width: 44px; height: 44px; margin: 0; padding: 0; border: 0;
    background: none; position: relative; cursor: pointer; flex: none;
  }
  input[type="checkbox"]::before, input[type="radio"]::before {
    content: ''; position: absolute; inset: 10px; box-sizing: border-box;
    border: 1.5px solid var(--border-input); border-radius: 5px;
    background: var(--surface);
  }
  input[type="radio"]::before { border-radius: 50%; }
  input[type="checkbox"]:checked::before,
  input[type="checkbox"]:indeterminate::before,
  input[type="radio"]:checked::before {
    background: var(--accent); border-color: var(--accent);
  }
  /* The tick: two borders of a rotated box, so it follows currentColor-ish
     tokens rather than shipping an image that cannot follow the theme. */
  input[type="checkbox"]:checked::after {
    content: ''; position: absolute; left: 17px; top: 19px;
    width: 10px; height: 5px;
    border: 2px solid var(--on-accent); border-top: 0; border-right: 0;
    transform: rotate(-45deg);
  }
  input[type="checkbox"]:indeterminate::after {
    content: ''; position: absolute; left: 16px; top: 21px;
    width: 12px; height: 2px; background: var(--on-accent);
  }
  input[type="radio"]:checked::after {
    content: ''; position: absolute; inset: 17px;
    border-radius: 50%; background: var(--on-accent);
  }
  input[type="checkbox"]:focus-visible, input[type="radio"]:focus-visible {
    outline: 2px solid var(--accent); outline-offset: -6px; border-radius: 8px;
  }
  input[type="checkbox"]:disabled, input[type="radio"]:disabled { cursor: not-allowed; opacity: .5; }
}


/* RETIRED 28 Aug — the side-by-side split, and why it is not coming back.
   It was the wrong answer to a right complaint. The rentals table needs ~1226px
   of content and the inventory ~671, so on any real screen the choice was
   squeeze both or scroll past one; the last version got them to fit only by
   dropping four of the inventory's six columns. Sub-views are the third option
   — each list gets the whole width and the other one is a click away. The
   markup keeps .rentals-split so nothing had to be re-nested; it is now a
   one-column grid that shows whichever panel the switcher chose. */

.rentals-split[data-sub="hires"] .rentals-split-col[data-view="stock"],
.rentals-split[data-sub="stock"] .rentals-split-col[data-view="hires"] { display: none; }

/* Full width again, so the compaction that paid for the split is off: pool,
   expiry and the row actions come back, and the country says its name. */
.rentals-split-col .kc-inv-detail { display: revert; }
.rentals-split-col .kc-inv-shrink { position: static; width: auto; height: auto;
  margin: 0; overflow: visible; clip: auto; clip-path: none; }

/* ─── SUB-VIEWS: a second level of navigation inside a tab ─── */
/*
   Reads as a level BELOW the tab bar and above the page, which is the whole
   job — the owner's reference (tenancydesk) gets that from a pill on a tinted
   ground rather than from an underline, because an underline at this level
   competes with the tab bar's own. So: quiet by default, the chosen one filled.
   The rule underneath ties the group to the content it switches.
*/
.kc-subviews {
  display: flex; gap: 4px; align-items: center; flex-wrap: wrap;
  margin: 0 0 14px; padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}
.kc-subview {
  appearance: none; border: 1px solid transparent; background: none;
  font: inherit; font-size: var(--fs-body); font-weight: 600;
  color: var(--muted); cursor: pointer;
  /* 44px tall — this is primary navigation on a counter tablet, so it is held
     to 2.5.5 (AAA) like the other counter surfaces, not to 2.5.8's 24. */
  min-height: 44px; padding: 0 16px; border-radius: 999px;
  display: inline-flex; align-items: center; gap: 8px;
  transition: background-color .15s ease, color .15s ease;
}
.kc-subview:hover { background: var(--bg-secondary); color: var(--text); }
.kc-subview.is-on {
  background: var(--primary-subdued); color: var(--accent);
  border-color: color-mix(in srgb, var(--accent) 35%, transparent);
}
.kc-subview-count {
  font-size: var(--fs-micro); font-weight: 600;
  color: var(--muted); background: var(--bg-secondary);
  border-radius: 999px; padding: 1px 7px; min-width: 20px; text-align: center;
}
